NODE_ENV=development
PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/enatega_delivery
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*
GRAPHQL_PATH=/graphql
LOG_LEVEL=info
GOOGLE_API_KEY=

# WhatsApp Cloud API (Meta)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=en_GB
WHATSAPP_ORDER_CREATED_TEMPLATE=zetahub_new_order
WHATSAPP_ORDER_STATUS_TEMPLATE=zetahub_order_status
WHATSAPP_RIDER_ASSIGNED_TEMPLATE=zetahub_rider_assigned

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_VENDOR_EMAIL=vendor@example.com
SEED_VENDOR_PASSWORD=ChangeThisVendorPassword123!
SEED_RIDER_PASSWORD=ChangeThisRiderPassword123!
