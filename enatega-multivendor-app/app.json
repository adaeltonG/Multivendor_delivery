{
  "expo": {
    "name": "NextHop",
    "scheme": "nexthop",
    "version": "1.0.57",
    "description": "NextHop makes it simple to discover restaurants, order food and follow deliveries in real time.",
    "slug": "nexthop",
    "owner": "adaelton",
    "androidStatusBar": {
      "backgroundColor": "#000000"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF6EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "uk.co.zetahub.nexthop",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow $(PRODUCT_NAME) to use location to determine the delivery address for your orders.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "Allow this app to collect app-related data that can be used for tracking you or your device.",
        "CFBundleURLTypes": []
      }
    },
    "notification": {
      "iosDisplayInForeground": true,
      "color": "#90E36D",
      "icon": "./assets/not-icon.png",
      "androidMode": "default",
      "androidCollapsedTitle": "NextHop"
    },
    "android": {
      "versionCode": 57,
      "package": "uk.co.zetahub.nexthop",
      "userInterfaceStyle": "automatic",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "plugins": [
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow this app to collect app-related data that can be used for tracking you or your device."
        }
      ],
      [
        "expo-updates",
        {
          "username": "adaelton"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow NextHop to use your location to find nearby restaurants and delivery addresses."
        }
      ],
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-font",
      "expo-localization",
      "expo-web-browser"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "50ffaddc-a9d4-432d-be00-d5178f580c7a"
      }
    }
  }
}
