{
  "expo": {
    "name": "NextHop Restaurant",
    "slug": "nexthop-restaurant",
    "owner": "adaelton",
    "description": "NextHop Restaurant helps restaurant teams manage menus, incoming orders and fulfilment.",
    "version": "1.0.33",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#EAF6EF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uk.co.zetahub.nexthop.restaurant",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "versionCode": 42,
      "package": "uk.co.zetahub.nexthop.restaurant",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      "@sentry/react-native",
      "expo-font",
      "expo-audio",
      "expo-asset"
    ]
  }
}
