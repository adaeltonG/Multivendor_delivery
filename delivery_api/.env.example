NODE_ENV=development
PORT=8001
MONGO_URI=mongodb://127.0.0.1:27017/enatega_delivery
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*
GRAPHQL_PATH=/graphql
LOG_LEVEL=info
GOOGLE_API_KEY=
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword123!
SEED_VENDOR_EMAIL=vendor@example.com
SEED_VENDOR_PASSWORD=ChangeThisVendorPassword123!
SEED_RIDER_PASSWORD=ChangeThisRiderPassword123!
